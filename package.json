{
  "name": "matrix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matrix — a spatial agent terminal workbench with offline Local Forge, real patch gates and a truecolor scope canvas.",
  "files": [
    "bin/",
    "lib/",
    "src/",
    "demo-project/",
    "README.md",
    "MATRIX.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "src/matrix.mjs",
  "bin": {
    "matrix": "./bin/matrix.mjs"
  },
  "scripts": {
    "start": "node bin/matrix.mjs",
    "matrix": "node bin/matrix.mjs",
    "tour": "node bin/matrix.mjs tour --demo",
    "vision": "node bin/matrix.mjs vision",
    "dump": "node bin/matrix.mjs dump --demo",
    "smoke": "node bin/matrix.mjs smoke --demo",
    "test": "node --test \"test/*.test.mjs\"",
    "bench": "node bin/matrix.mjs bench",
    "doctor": "node bin/matrix.mjs doctor",
    "syntax": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --project jsconfig.json --pretty false",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "coverage": "node scripts/check-coverage.mjs",
    "eval": "node eval/run.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "npm run syntax && npm run lint && npm run typecheck && npm run format:check && npm run coverage"
  },
  "keywords": [
    "matrix",
    "tui",
    "multi-agent",
    "swarm",
    "local-first",
    "code-agent",
    "openrouter",
    "truecolor"
  ],
  "author": "mitravanu",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/punycode": "2.1.4",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
