{
  "name": "matrix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matrix — a spatial agent terminal workbench with offline Local Forge, real patch gates and a truecolor scope canvas.",
  "main": "src/matrix.mjs",
  "bin": {
    "matrix": "./bin/matrix.mjs"
  },
  "scripts": {
    "start": "node bin/matrix.mjs",
    "matrix": "node bin/matrix.mjs",
    "tour": "node bin/matrix.mjs tour --demo",
    "vision": "node bin/matrix.mjs vision",
    "dump": "node bin/matrix.mjs dump --demo",
    "smoke": "node bin/matrix.mjs smoke --demo",
    "test": "node --test \"test/*.test.mjs\"",
    "bench": "node bin/matrix.mjs bench",
    "doctor": "node bin/matrix.mjs doctor",
    "check": "npm run test"
  },
  "keywords": [
    "matrix",
    "tui",
    "multi-agent",
    "swarm",
    "local-first",
    "code-agent",
    "openrouter",
    "truecolor"
  ],
  "author": "mitravanu",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
